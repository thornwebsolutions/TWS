---
import Icon from './Icon.astro';
interface Props {
  href: string;
  title: string;
  excerpt: string;
  category?: string;
  readTime?: string;
}
const { href, title, excerpt, category, readTime } = Astro.props;
---
<a class="post" href={href} data-cursor>
  <div class="top">
    {category && <span class="cat">{category}</span>}
    {readTime && <span class="rt">{readTime}</span>}
  </div>
  <h3>{title}</h3>
  <p>{excerpt}</p>
  <span class="read">Read article <Icon name="arrow" size={16} /></span>
</a>

<style>
  .post {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: 28px;
    transition: transform 0.45s var(--ease-out-expo), border-color 0.4s, background 0.4s;
  }
  .post:hover {
    transform: translateY(-6px);
    border-color: rgba(16, 185, 129, 0.3);
    background: rgba(255, 255, 255, 0.045);
  }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin-bottom: 16px; }
  .cat {
    font-size: 11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.2px;
    color: var(--color-emerald-light);
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.22);
    padding: 5px 11px;
    border-radius: 50px;
  }
  .rt { font-size: 12.5px; color: rgba(255, 255, 255, 0.45); }
  .post h3 { font-size: 18px; font-weight: 600; line-height: 1.4; margin-bottom: 10px; }
  .post p { font-size: 14.5px; color: rgba(255, 255, 255, 0.6); line-height: 1.65; flex: 1; margin-bottom: 18px; }
  .read {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: var(--color-emerald);
    font-size: 14px;
    font-weight: 600;
  }
  .read :global(svg) { transition: transform 0.3s var(--ease-out-expo); }
  .post:hover .read :global(svg) { transform: translateX(5px); }
</style>
