---
import Section from '../Section.astro';
import Icon from '../Icon.astro';
import { maintenance } from '../../data/content';
---
<Section id="maintenance" panel>
  <div class="wrap" data-reveal>
    <div class="halo" aria-hidden="true"></div>
    <span class="eyebrow">Ongoing care</span>
    <h2>Support &amp; Maintenance</h2>
    <div class="price">
      <span class="from">Starting at</span>
      <span class="amount"><sup>$</sup>{maintenance.price}<span class="per">{maintenance.period}</span></span>
    </div>

    <div class="pills" data-reveal-group>
      {maintenance.features.map((f) => (
        <div class="pill" data-reveal-item>
          <Icon name="check" size={16} /> {f}
        </div>
      ))}
    </div>

    <a href="#contact" class="btn-primary" data-magnetic="0.3">
      Keep my site running <Icon name="arrow" size={18} />
    </a>
  </div>
</Section>

<style>
  .wrap {
    position: relative;
    text-align: center;
    max-width: 820px;
    margin-inline: auto;
  }
  .halo {
    position: absolute;
    top: -60px;
    left: 50%;
    transform: translateX(-50%);
    width: 420px;
    height: 420px;
    max-width: 90vw;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.18), transparent 65%);
    pointer-events: none;
    z-index: -1;
  }
  .eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-emerald);
    margin-bottom: 14px;
  }
  h2 {
    font-family: var(--font-display);
    font-size: clamp(30px, 5vw, 42px);
    font-weight: 700;
  }
  .price { margin: 22px 0 36px; }
  .from { display: block; font-size: 14px; color: rgba(255, 255, 255, 0.5); margin-bottom: 6px; }
  .amount {
    font-family: var(--font-display);
    font-size: clamp(44px, 8vw, 60px);
    font-weight: 700;
    color: var(--color-emerald);
  }
  .amount sup { font-size: 0.5em; top: -0.8em; }
  .per { font-size: 20px; font-weight: 500; color: rgba(255, 255, 255, 0.6); margin-left: 4px; }

  .pills {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
    max-width: 640px;
    margin: 0 auto 38px;
  }
  .pill {
    display: flex;
    align-items: center;
    gap: 10px;
    justify-content: center;
    text-align: left;
    background: rgba(16, 185, 129, 0.08);
    border: 1px solid rgba(16, 185, 129, 0.22);
    border-radius: 14px;
    padding: 16px 22px;
    font-size: 14.5px;
    color: rgba(255, 255, 255, 0.88);
    transition: background 0.35s, border-color 0.35s, transform 0.35s;
  }
  .pill :global(svg) { color: var(--color-emerald); flex-shrink: 0; }
  .pill:hover {
    background: rgba(16, 185, 129, 0.14);
    border-color: rgba(16, 185, 129, 0.4);
    transform: translateY(-3px);
  }

  @media (max-width: 600px) {
    .pills { grid-template-columns: 1fr; }
  }
</style>
