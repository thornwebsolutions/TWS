---
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';
import { testimonials } from '../../data/content';
---
<Section id="testimonials" panel>
  <SectionHeader
    eyebrow="Client love"
    title="What clients <span class='gradient-text'>say</span>"
    subtitle="Don’t just take my word for it."
  />

  <div class="grid" data-reveal-group>
    {testimonials.map((t) => (
      <figure class="card" data-reveal-item>
        <div class="quote-mark" aria-hidden="true">&ldquo;</div>
        <div class="stars" aria-label="5 out of 5 stars">
          {Array.from({ length: 5 }).map(() => <Icon name="star" size={18} />)}
        </div>
        <blockquote>{t.quote}</blockquote>
        <figcaption>
          <span class="avatar">{t.name.charAt(0)}</span>
          <span class="who">
            <strong>{t.name}</strong>
            <span>{t.role}</span>
          </span>
        </figcaption>
      </figure>
    ))}
  </div>
</Section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 26px;
  }
  .card {
    position: relative;
    background: rgba(255, 255, 255, 0.035);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 20px;
    padding: 34px 30px;
    overflow: hidden;
    transition: transform 0.45s var(--ease-out-expo), border-color 0.4s;
  }
  .card:hover { transform: translateY(-6px); border-color: rgba(16, 185, 129, 0.3); }
  .quote-mark {
    position: absolute;
    top: 6px;
    right: 22px;
    font-family: var(--font-display);
    font-size: 90px;
    line-height: 1;
    color: rgba(16, 185, 129, 0.12);
  }
  .stars { display: flex; gap: 4px; color: var(--color-star); margin-bottom: 16px; }
  blockquote { font-size: 15.5px; color: rgba(255, 255, 255, 0.85); line-height: 1.75; margin-bottom: 24px; position: relative; }
  figcaption { display: flex; align-items: center; gap: 12px; }
  .avatar {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    font-weight: 700;
    color: #052e1b;
    background: linear-gradient(135deg, var(--color-emerald-light), var(--color-emerald));
  }
  .who strong { display: block; font-size: 15px; font-weight: 600; }
  .who span { font-size: 13px; color: rgba(255, 255, 255, 0.5); }

  @media (max-width: 880px) {
    .grid { grid-template-columns: 1fr; max-width: 460px; margin-inline: auto; }
  }
</style>
