---
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import Icon from '../Icon.astro';
import { site } from '../../data/site';
---
<Section id="contact">
  <SectionHeader
    eyebrow="Get in touch"
    title="Let’s <span class='gradient-text'>work together</span>"
    subtitle="Ready to elevate your online presence? Let’s discuss how we can help your business grow."
  />

  <div class="layout">
    <aside class="aside" data-reveal>
      <h3>Talk to a real person.</h3>
      <p>Tell me about your project and I’ll reply personally — usually within a day.</p>
      <div class="links">
        <a href={site.phoneHref}><span class="ico"><Icon name="phone" size={18} /></span> {site.phoneDisplay}</a>
        <a href={`mailto:${site.email}`}><span class="ico"><Icon name="mail" size={18} /></span> {site.email}</a>
        <div class="loc"><span class="ico"><Icon name="sparkle" size={18} /></span> {site.address.locality}, {site.address.region} · Serving {site.areaServed} &amp; beyond</div>
      </div>
    </aside>

    <div class="card" data-reveal data-reveal-delay="0.1">
      <h3>Send a message</h3>
      <form class="form" id="contact-form" novalidate>
        <div class="field">
          <label for="name">Name</label>
          <input type="text" id="name" name="name" placeholder="Your name" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="your@email.com" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" placeholder="Tell me about your project..." required></textarea>
        </div>
        <button type="submit" class="btn-primary submit">Send message <Icon name="arrow" size={18} /></button>
      </form>
    </div>
  </div>
</Section>

<style>
  .layout {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 36px;
    max-width: 980px;
    margin-inline: auto;
    align-items: start;
  }
  .aside { padding-top: 8px; }
  .aside h3 { font-family: var(--font-display); font-size: 26px; font-weight: 700; margin-bottom: 12px; }
  .aside > p { color: rgba(255, 255, 255, 0.62); line-height: 1.7; margin-bottom: 28px; }
  .links { display: flex; flex-direction: column; gap: 16px; }
  .links a, .links .loc {
    display: flex;
    align-items: center;
    gap: 13px;
    color: rgba(255, 255, 255, 0.82);
    font-size: 15px;
    line-height: 1.5;
    transition: color 0.3s;
  }
  .links a:hover { color: var(--color-emerald); }
  .ico {
    width: 40px;
    height: 40px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 12px;
    background: rgba(16, 185, 129, 0.12);
    border: 1px solid rgba(16, 185, 129, 0.25);
    color: var(--color-emerald);
  }

  .card {
    background: linear-gradient(160deg, rgba(16, 185, 129, 0.1), rgba(255, 255, 255, 0.03));
    border: 1px solid rgba(16, 185, 129, 0.22);
    border-radius: 22px;
    padding: 38px;
  }
  .card h3 { font-family: var(--font-display); font-size: 22px; font-weight: 600; margin-bottom: 22px; }
  .form { display: flex; flex-direction: column; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 6px; }
  label { font-size: 14px; font-weight: 500; color: rgba(255, 255, 255, 0.8); }
  input, textarea {
    width: 100%;
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    color: #fff;
    font-family: var(--font-sans);
    font-size: 15px;
    transition: border-color 0.3s, background 0.3s, box-shadow 0.3s;
  }
  input::placeholder, textarea::placeholder { color: rgba(255, 255, 255, 0.4); }
  input:focus, textarea:focus {
    outline: none;
    border-color: var(--color-emerald);
    background: rgba(255, 255, 255, 0.08);
    box-shadow: 0 0 0 3px rgba(16, 185, 129, 0.15);
  }
  textarea { resize: vertical; min-height: 130px; }
  .submit { margin-top: 6px; width: 100%; }
  .submit:disabled { opacity: 0.7; cursor: not-allowed; transform: none; }

  .form-status {
    padding: 13px 16px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
  }
  .form-status.success { background: rgba(16, 185, 129, 0.2); border: 1px solid rgba(16, 185, 129, 0.4); color: var(--color-emerald-light); }
  .form-status.error { background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; }

  @media (max-width: 820px) {
    .layout { grid-template-columns: 1fr; gap: 30px; }
    .card { padding: 30px 24px; }
  }
</style>

<script>
  function setupContactForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    if (!form || form.dataset.bound) return;
    form.dataset.bound = 'true';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const button = form.querySelector('button') as HTMLButtonElement;
      const original = button.innerHTML;
      form.querySelector('.form-status')?.remove();

      button.disabled = true;
      button.textContent = 'Sending...';

      const data = {
        name: (form.querySelector('#name') as HTMLInputElement).value,
        email: (form.querySelector('#email') as HTMLInputElement).value,
        message: (form.querySelector('#message') as HTMLTextAreaElement).value,
      };

      const status = document.createElement('div');
      status.className = 'form-status';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data),
        });
        if (res.ok) {
          status.classList.add('success');
          status.textContent = "Message sent successfully! I'll get back to you soon.";
          form.reset();
        } else {
          status.classList.add('error');
          status.textContent = 'Something went wrong. Please try again or email me directly.';
        }
      } catch {
        status.classList.add('error');
        status.textContent = 'Something went wrong. Please try again or email me directly.';
      } finally {
        form.appendChild(status);
        button.disabled = false;
        button.innerHTML = original;
      }
    });
  }
  document.addEventListener('astro:page-load', setupContactForm);
</script>
