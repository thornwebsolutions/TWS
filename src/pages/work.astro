---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { portfolio } from '../data/content';
import { site } from '../data/site';

const title = `Our Work | ${site.name}`;
const description =
  'A selection of custom websites built for service-based businesses — clean, fast, and conversion-focused. See recent launches from Thorn Web Solutions.';
---
<BaseLayout title={title} description={description} canonical="/work">
  <header class="work-hero">
    <div class="container">
      <span class="eyebrow" data-reveal>Selected work</span>
      <h1 data-reveal>Recent <span class="gradient-text">launches</span></h1>
      <p data-reveal>
        A selection of custom websites built for service-based organizations — each one
        designed to build trust, reduce friction, and turn visitors into real inquiries.
      </p>
    </div>
  </header>

  <div class="container projects">
    {portfolio.map((p, i) => (
      <article class={`project ${i % 2 === 1 ? 'reverse' : ''}`}>
        <a class="shot" href={p.url} target="_blank" rel="noopener" data-reveal data-cursor>
          <div class="shot-inner">
            <img src={p.image} alt={p.alt} loading="lazy" decoding="async" width="1500" height="900" />
          </div>
          <span class="shot-visit">Visit site <Icon name="external" size={16} /></span>
        </a>

        <div class="info" data-reveal data-reveal-delay="0.1">
          <span class="tag">{p.tag}</span>
          <h2>{p.title}</h2>
          <p>{p.summary}</p>
          <ul class="services">
            {p.services.map((s) => <li><Icon name="check" size={15} /> {s}</li>)}
          </ul>
          <a class="visit-link" href={p.url} target="_blank" rel="noopener" data-magnetic="0.2">
            View live site <Icon name="arrow" size={17} />
          </a>
        </div>
      </article>
    ))}
  </div>

  <section class="work-cta">
    <div class="container" data-reveal>
      <div class="halo" aria-hidden="true"></div>
      <h2>Your business could be next.</h2>
      <p>Let’s build a website that works as hard as you do.</p>
      <a href="/#contact" class="btn-primary" data-magnetic="0.3">Start your project <Icon name="arrow" size={18} /></a>
    </div>
  </section>
</BaseLayout>

<style>
  .work-hero { padding: 160px 0 40px; text-align: center; }
  .eyebrow {
    display: inline-block;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--color-emerald);
    margin-bottom: 16px;
  }
  .work-hero h1 { font-family: var(--font-display); font-size: clamp(40px, 7vw, 68px); font-weight: 800; line-height: 1.1; }
  .work-hero p { max-width: 620px; margin: 18px auto 0; color: rgba(255, 255, 255, 0.65); font-size: 17px; line-height: 1.7; }

  .projects { padding: 50px 30px 30px; display: flex; flex-direction: column; gap: 90px; }
  .project {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 50px;
    align-items: center;
  }
  .project.reverse { grid-template-columns: 0.85fr 1.15fr; }
  .project.reverse .shot { order: 2; }
  .project.reverse .info { order: 1; }

  .shot {
    position: relative;
    display: block;
    border-radius: 20px;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 30px 70px rgba(0, 0, 0, 0.35);
  }
  .shot-inner { display: block; }
  .shot-inner img {
    width: 100%;
    height: auto;
    display: block;
    transform-origin: top center;
    transition: transform 0.6s var(--ease-out-expo);
  }
  .shot:hover .shot-inner img { transform: scale(1.04); }
  .shot-visit {
    position: absolute;
    bottom: 16px;
    right: 16px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 13px;
    font-weight: 600;
    color: #fff;
    background: rgba(8, 16, 30, 0.7);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.15);
    padding: 8px 14px;
    border-radius: 50px;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity 0.4s, transform 0.4s var(--ease-out-expo);
  }
  .shot:hover .shot-visit { opacity: 1; transform: translateY(0); }

  .tag {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--color-emerald-light);
  }
  .info h2 { font-family: var(--font-display); font-size: clamp(28px, 4vw, 38px); font-weight: 700; margin: 10px 0 14px; }
  .info p { color: rgba(255, 255, 255, 0.7); font-size: 16px; line-height: 1.75; margin-bottom: 20px; }
  .services { list-style: none; display: flex; flex-wrap: wrap; gap: 10px 20px; margin-bottom: 24px; }
  .services li { display: flex; align-items: center; gap: 8px; font-size: 14px; color: rgba(255, 255, 255, 0.8); }
  .services li :global(svg) { color: var(--color-emerald); flex-shrink: 0; }
  .visit-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 600;
    color: var(--color-emerald);
    transition: gap 0.3s var(--ease-out-expo);
  }
  .visit-link :global(svg) { transition: transform 0.3s var(--ease-out-expo); }
  .visit-link:hover { gap: 12px; }
  .visit-link:hover :global(svg) { transform: translateX(3px); }

  .work-cta { padding: 90px 0 60px; text-align: center; }
  .work-cta .container { position: relative; }
  .halo {
    position: absolute;
    top: -40px;
    left: 50%;
    transform: translateX(-50%);
    width: 420px;
    height: 420px;
    max-width: 90vw;
    background: radial-gradient(circle, rgba(16, 185, 129, 0.16), transparent 65%);
    pointer-events: none;
    z-index: -1;
  }
  .work-cta h2 { font-family: var(--font-display); font-size: clamp(28px, 5vw, 42px); font-weight: 700; }
  .work-cta p { color: rgba(255, 255, 255, 0.65); font-size: 17px; margin: 12px 0 28px; }

  @media (max-width: 820px) {
    .project, .project.reverse { grid-template-columns: 1fr; gap: 26px; }
    .project.reverse .shot { order: 0; }
    .project.reverse .info { order: 0; }
  }
</style>
